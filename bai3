#include <stdio.h>
#include <string.h>

struct SinhVien {
    char hoTen[50];
    char maSV[20];
    float diem1;
    float diem2;
    float diem3;
};

int main() {
    int n, i;
    struct SinhVien ds[100];
    struct SinhVien *p;

    // Nhap so luong sinh vien
    printf("Nhap so luong sinh vien: ");
    scanf("%d", &n);
    getchar();

    p = ds;

    // Nhap danh sach sinh vien bang con tro
    for (i = 0; i < n; i++) {
        printf("\nNhap thong tin sinh vien thu %d:\n", i + 1);

        printf("Ho ten: ");
        fgets((p + i)->hoTen, 50, stdin);
        (p + i)->hoTen[strcspn((p + i)->hoTen, "\n")] = '\0';

        printf("Ma sinh vien: ");
        fgets((p + i)->maSV, 20, stdin);
        (p + i)->maSV[strcspn((p + i)->maSV, "\n")] = '\0';

        printf("Diem 1: ");
        scanf("%f", &(p + i)->diem1);

        printf("Diem 2: ");
        scanf("%f", &(p + i)->diem2);

        printf("Diem 3: ");
        scanf("%f", &(p + i)->diem3);

        getchar();
    }

    // In danh sach sinh vien bang con tro
    printf("\n========== DANH SACH SINH VIEN ==========\n");
    printf("%-20s %-15s %-10s %-10s %-10s\n",
           "Ho ten", "Ma SV", "Diem 1", "Diem 2", "Diem 3");

    for (i = 0; i < n; i++) {
        printf("%-20s %-15s %-10.2f %-10.2f %-10.2f\n",
               (p + i)->hoTen,
               (p + i)->maSV,
               (p + i)->diem1,
               (p + i)->diem2,
               (p + i)->diem3);
    }

    return 0;
}
