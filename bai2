#include <stdio.h>

int main() {
    int m, n, i, j;
    float a[100][100];
    float *p;

    // Nhap so dong va so cot
    printf("Nhap so dong: ");
    scanf("%d", &m);

    printf("Nhap so cot: ");
    scanf("%d", &n);

    p = &a[0][0];

    // Nhap mang bang con tro
    for (i = 0; i < m; i++) {
        for (j = 0; j < n; j++) {
            printf("a[%d][%d] = ", i, j);
            scanf("%f", p + i * n + j);
        }
    }

    // In mang bang con tro
    printf("\nMang 2 chieu vua nhap la:\n");
    for (i = 0; i < m; i++) {
        for (j = 0; j < n; j++) {
            printf("%.2f\t", *(p + i * n + j));
        }
        printf("\n");
    }

    return 0;
}
